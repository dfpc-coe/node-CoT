{
    "compilerOptions": {
        "strict": true,
        "module": "esnext",
        "target": "es2022",
        "lib": ["es2023", "dom", "dom.iterable"],
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["vite/client"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.vue",
        "vite.config.ts"
    ]
}
